include "TriggerLibs/NativeLib"

// Instant Arena v0.1.4 - standard multiplayer unit roster.
// The build script embeds this code into the map's editable Custom Script element.

const int ARENA_PLAYER = 1;
const int ARENA_ENEMY = 15;
const int ARENA_LIMIT = 100;

unitgroup arenaMyArmy;
unitgroup arenaEnemyArmy;
point arenaMySpawn;
point arenaEnemySpawn;
int arenaDialog;
int arenaRaceMenu;
int arenaUnitMenu;
int arenaSpawnButton;
int arenaEnemyButton;
int arenaClearButton;
int arenaResetButton;
int arenaStatusLabel;
int arenaSpeedSlider;
int arenaSpeedLabel;
int arenaSpeedIndex = -1;

void ArenaRefreshStatus () {
    string status;
    status = "Yours: " + IntToString(UnitGroupCount(arenaMyArmy, c_unitCountAlive));
    status = status + " / 100     Enemy: ";
    status = status + IntToString(UnitGroupCount(arenaEnemyArmy, c_unitCountAlive)) + " / 100";
    libNtve_gf_SetDialogItemText(arenaStatusLabel, StringToText(status), PlayerGroupSingle(ARENA_PLAYER));
}

int ArenaButton (string caption, int y) {
    int control;
    control = DialogControlCreate(arenaDialog, c_triggerControlTypeButton);
    DialogControlSetSize(control, PlayerGroupSingle(ARENA_PLAYER), 260, 38);
    DialogControlSetPosition(control, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, y);
    libNtve_gf_SetDialogItemText(control, StringToText(caption), PlayerGroupSingle(ARENA_PLAYER));
    return control;
}

int ArenaMenu (int y) {
    int control;
    control = DialogControlCreate(arenaDialog, c_triggerControlTypePulldown);
    // SC2's pulldown frame needs more vertical padding than a plain button.
    DialogControlSetSize(control, PlayerGroupSingle(ARENA_PLAYER), 260, 52);
    DialogControlSetPosition(control, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, y);
    return control;
}

// Pulldown item indices start at 1. Invalid selections never create a unit.
// Standard multiplayer units in their normal mobile form; no custom assets.
int ArenaUnitCount (int race) {
    if (race == 1) { return 17; }
    if (race == 2) { return 18; }
    if (race == 3) { return 17; }
    return 0;
}

string ArenaUnitType (int race, int index) {
    if (race == 1) {
        if (index == 1) { return "Marine"; }
        if (index == 2) { return "Marauder"; }
        if (index == 3) { return "Reaper"; }
        if (index == 4) { return "Ghost"; }
        if (index == 5) { return "Hellion"; }
        if (index == 6) { return "HellionTank"; }
        if (index == 7) { return "WidowMine"; }
        if (index == 8) { return "Cyclone"; }
        if (index == 9) { return "SiegeTank"; }
        if (index == 10) { return "Thor"; }
        if (index == 11) { return "VikingFighter"; }
        if (index == 12) { return "Medivac"; }
        if (index == 13) { return "Liberator"; }
        if (index == 14) { return "Banshee"; }
        if (index == 15) { return "Raven"; }
        if (index == 16) { return "Battlecruiser"; }
        if (index == 17) { return "SCV"; }
    }
    else if (race == 2) {
        if (index == 1) { return "Zealot"; }
        if (index == 2) { return "Stalker"; }
        if (index == 3) { return "Sentry"; }
        if (index == 4) { return "Adept"; }
        if (index == 5) { return "HighTemplar"; }
        if (index == 6) { return "DarkTemplar"; }
        if (index == 7) { return "Archon"; }
        if (index == 8) { return "Immortal"; }
        if (index == 9) { return "Colossus"; }
        if (index == 10) { return "Disruptor"; }
        if (index == 11) { return "Observer"; }
        if (index == 12) { return "WarpPrism"; }
        if (index == 13) { return "Phoenix"; }
        if (index == 14) { return "VoidRay"; }
        if (index == 15) { return "Oracle"; }
        if (index == 16) { return "Tempest"; }
        if (index == 17) { return "Carrier"; }
        if (index == 18) { return "Probe"; }
    }
    else if (race == 3) {
        if (index == 1) { return "Zergling"; }
        if (index == 2) { return "Baneling"; }
        if (index == 3) { return "Roach"; }
        if (index == 4) { return "Ravager"; }
        if (index == 5) { return "Hydralisk"; }
        if (index == 6) { return "LurkerMP"; }
        if (index == 7) { return "Infestor"; }
        if (index == 8) { return "SwarmHostMP"; }
        if (index == 9) { return "Ultralisk"; }
        if (index == 10) { return "Queen"; }
        if (index == 11) { return "Overlord"; }
        if (index == 12) { return "Overseer"; }
        if (index == 13) { return "Mutalisk"; }
        if (index == 14) { return "Corruptor"; }
        if (index == 15) { return "BroodLord"; }
        if (index == 16) { return "Viper"; }
        if (index == 17) { return "Drone"; }
    }
    return "";
}

string ArenaSelectedUnitType () {
    return ArenaUnitType(DialogControlGetSelectedItem(arenaRaceMenu, ARENA_PLAYER),
        DialogControlGetSelectedItem(arenaUnitMenu, ARENA_PLAYER));
}

void ArenaRefreshSelection () {
    string unitType;
    unitType = ArenaSelectedUnitType();
    if (unitType == "") {
        return;
    }
    libNtve_gf_SetDialogItemText(arenaSpawnButton, StringToText("Spawn My ") + UnitTypeGetName(unitType), PlayerGroupSingle(ARENA_PLAYER));
    libNtve_gf_SetDialogItemText(arenaEnemyButton, StringToText("Spawn Enemy ") + UnitTypeGetName(unitType), PlayerGroupSingle(ARENA_PLAYER));
}

void ArenaFillUnitMenu () {
    int race;
    int index;
    race = DialogControlGetSelectedItem(arenaRaceMenu, ARENA_PLAYER);
    if (race < 1 || race > 3) {
        return;
    }
    DialogControlRemoveAllItems(arenaUnitMenu, PlayerGroupSingle(ARENA_PLAYER));
    index = 1;
    while (index <= ArenaUnitCount(race)) {
        DialogControlAddItem(arenaUnitMenu, PlayerGroupSingle(ARENA_PLAYER), UnitTypeGetName(ArenaUnitType(race, index)));
        index += 1;
    }
    DialogControlSelectItem(arenaUnitMenu, PlayerGroupSingle(ARENA_PLAYER), 1);
    ArenaRefreshSelection();
}

bool ArenaMenuChanged (bool testConds, bool runActions) {
    if (!runActions || EventPlayer() != ARENA_PLAYER) {
        return true;
    }
    if (EventDialogControl() == arenaRaceMenu) {
        ArenaFillUnitMenu();
    }
    else if (EventDialogControl() == arenaUnitMenu) {
        ArenaRefreshSelection();
    }
    return true;
}

string ArenaSpeedName (int speed) {
    if (speed == c_gameSpeedSlower) { return "Slower"; }
    if (speed == c_gameSpeedSlow) { return "Slow"; }
    if (speed == c_gameSpeedNormal) { return "Normal"; }
    if (speed == c_gameSpeedFast) { return "Fast"; }
    if (speed == c_gameSpeedFaster) { return "Faster"; }
    return "Unknown";
}

void ArenaRefreshSpeed () {
    int speed;
    speed = GameGetSpeedValue();
    // Read back the engine's actual speed before updating the label and slider.
    arenaSpeedIndex = speed;
    libNtve_gf_SetDialogItemText(arenaSpeedLabel,
        StringToText("Game speed: " + ArenaSpeedName(speed)), PlayerGroupSingle(ARENA_PLAYER));
    if (DialogControlGetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyValue, ARENA_PLAYER) != IntToFixed(speed)) {
        DialogControlSetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyValue,
            PlayerGroupSingle(ARENA_PLAYER), IntToFixed(speed));
    }
}

void ArenaSetSpeed (int speed) {
    if (speed < c_gameSpeedSlower) { speed = c_gameSpeedSlower; }
    if (speed > c_gameSpeedFaster) { speed = c_gameSpeedFaster; }
    if (GameGetSpeedValue() != speed) {
        GameSetSpeedValue(speed);
    }
    ArenaRefreshSpeed();
}

bool ArenaSpeedChanged (bool testConds, bool runActions) {
    int speed;
    if (!runActions || EventPlayer() != ARENA_PLAYER || EventDialogControl() != arenaSpeedSlider) {
        return true;
    }
    // The engine has five discrete presets. Snap dragging to the nearest one.
    speed = FixedToInt(DialogControlGetPropertyAsFixed(arenaSpeedSlider,
        c_triggerControlPropertyValue, ARENA_PLAYER) + 0.5);
    ArenaSetSpeed(speed);
    return true;
}

bool ArenaSpeedSync (bool testConds, bool runActions) {
    // Keep the control accurate if speed is changed through SC2's own controls.
    if (runActions && GameGetSpeedValue() != arenaSpeedIndex) {
        ArenaRefreshSpeed();
    }
    return true;
}

void ArenaClearGroup (unitgroup army) {
    unit target;
    while (UnitGroupCount(army, c_unitCountAll) > 0) {
        target = UnitGroupUnit(army, 1);
        UnitGroupRemove(army, target);
        UnitRemove(target);
    }
}

void ArenaSpawn (int owner) {
    unitgroup army;
    unitgroup created;
    unit spawned;
    point spawn;
    fixed facing;
    string unitType;
    unitType = ArenaSelectedUnitType();
    if (unitType == "") {
        return;
    }
    if (owner == ARENA_PLAYER) {
        army = arenaMyArmy;
        spawn = arenaMySpawn;
        facing = 0.0;
    }
    else {
        army = arenaEnemyArmy;
        spawn = arenaEnemySpawn;
        facing = 180.0;
    }
    if (UnitGroupCount(army, c_unitCountAlive) >= ARENA_LIMIT) {
        UIDisplayMessage(PlayerGroupSingle(ARENA_PLAYER), c_messageAreaSubtitle,
            StringToText("100 living units on this side. Clear an army or fight to make room."));
        return;
    }
    created = UnitCreate(1, unitType, 0, owner, spawn, facing);
    spawned = UnitGroupUnit(created, 1);
    // Normal placement lets SC2 find nearby space instead of stacking units.
    if (spawned != null) {
        UnitGroupAdd(army, spawned);
        if (owner == ARENA_ENEMY) {
            if (UnitAbilityExists(spawned, "attack")) {
                UnitIssueOrder(spawned,
                    OrderTargetingPoint(AbilityCommand("attack", 0), arenaMySpawn), c_orderQueueReplace);
            }
            else if (UnitAbilityExists(spawned, "move")) {
                // Transports, detectors, and other support units cannot attack.
                UnitIssueOrder(spawned,
                    OrderTargetingPoint(AbilityCommand("move", 0), arenaMySpawn), c_orderQueueReplace);
            }
        }
    }
    else {
        UIDisplayMessage(PlayerGroupSingle(ARENA_PLAYER), c_messageAreaSubtitle,
            StringToText("No room here. Move units away or clear an army."));
    }
    ArenaRefreshStatus();
}

bool ArenaButtonClicked (bool testConds, bool runActions) {
    int control;
    if (!runActions || EventPlayer() != ARENA_PLAYER) {
        return true;
    }
    control = EventDialogControl();
    if (control == arenaSpawnButton) {
        ArenaSpawn(ARENA_PLAYER);
    }
    else if (control == arenaEnemyButton) {
        ArenaSpawn(ARENA_ENEMY);
    }
    else if (control == arenaClearButton) {
        ArenaClearGroup(arenaMyArmy);
        ArenaRefreshStatus();
    }
    else if (control == arenaResetButton) {
        ArenaClearGroup(arenaMyArmy);
        ArenaClearGroup(arenaEnemyArmy);
        ArenaRefreshStatus();
    }
    return true;
}

bool ArenaUnitDied (bool testConds, bool runActions) {
    unit target;
    if (!runActions) {
        return true;
    }
    target = EventUnit();
    if (UnitGroupHasUnit(arenaMyArmy, target) || UnitGroupHasUnit(arenaEnemyArmy, target)) {
        UnitGroupRemove(arenaMyArmy, target);
        UnitGroupRemove(arenaEnemyArmy, target);
        ArenaRefreshStatus();
        // Remove the dead unit handle so long sessions do not accumulate corpses.
        UnitRemove(target);
    }
    return true;
}

void ArenaInit () {
    int titleLabel;
    int helpLabel;
    int speedHelpLabel;
    trigger buttonTrigger;
    trigger menuTrigger;
    trigger speedTrigger;
    trigger speedSyncTrigger;
    trigger deathTrigger;

    arenaMyArmy = UnitGroupEmpty();
    arenaEnemyArmy = UnitGroupEmpty();
    arenaMySpawn = Point(9.0, 16.0);
    arenaEnemySpawn = Point(23.0, 16.0);

    // Deliberately omit melee initialization: no starting economy or defeat rules.
    libNtve_gf_SetAlliance(ARENA_PLAYER, ARENA_ENEMY, libNtve_ge_AllianceSetting_Enemy);
    VisRevealArea(ARENA_PLAYER, RegionEntireMap(), 0.0, false);
    CameraPan(ARENA_PLAYER, Point(16.0, 16.0), 0.0, 0.0, 10.0, false);

    arenaDialog = DialogCreate(300, 526, c_anchorTopLeft, 14, 14, false);
    titleLabel = DialogControlCreate(arenaDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(titleLabel, PlayerGroupSingle(ARENA_PLAYER), 260, 24);
    DialogControlSetPosition(titleLabel, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, 16);
    libNtve_gf_SetDialogItemText(titleLabel, StringToText("INSTANT ARENA - SOLO"), PlayerGroupSingle(ARENA_PLAYER));

    arenaStatusLabel = DialogControlCreate(arenaDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(arenaStatusLabel, PlayerGroupSingle(ARENA_PLAYER), 260, 24);
    DialogControlSetPosition(arenaStatusLabel, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, 42);
    arenaRaceMenu = ArenaMenu(72);
    DialogControlAddItem(arenaRaceMenu, PlayerGroupSingle(ARENA_PLAYER), StringToText("Terran"));
    DialogControlAddItem(arenaRaceMenu, PlayerGroupSingle(ARENA_PLAYER), StringToText("Protoss"));
    DialogControlAddItem(arenaRaceMenu, PlayerGroupSingle(ARENA_PLAYER), StringToText("Zerg"));
    DialogControlSelectItem(arenaRaceMenu, PlayerGroupSingle(ARENA_PLAYER), 1);
    arenaUnitMenu = ArenaMenu(132);
    arenaSpawnButton = ArenaButton("Spawn My Marine", 198);
    arenaEnemyButton = ArenaButton("Spawn Enemy Marine", 242);
    arenaClearButton = ArenaButton("Clear My Army", 286);
    arenaResetButton = ArenaButton("Reset Arena", 330);
    ArenaFillUnitMenu();
    helpLabel = DialogControlCreate(arenaDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(helpLabel, PlayerGroupSingle(ARENA_PLAYER), 260, 26);
    DialogControlSetPosition(helpLabel, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, 382);
    libNtve_gf_SetDialogItemText(helpLabel, StringToText("Choose race, unit, then spawn."), PlayerGroupSingle(ARENA_PLAYER));

    arenaSpeedLabel = DialogControlCreate(arenaDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(arenaSpeedLabel, PlayerGroupSingle(ARENA_PLAYER), 260, 24);
    DialogControlSetPosition(arenaSpeedLabel, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, 418);
    arenaSpeedSlider = DialogControlCreate(arenaDialog, c_triggerControlTypeSlider);
    DialogControlSetSize(arenaSpeedSlider, PlayerGroupSingle(ARENA_PLAYER), 260, 32);
    DialogControlSetPosition(arenaSpeedSlider, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, 450);
    DialogControlSetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyMinValue,
        PlayerGroupSingle(ARENA_PLAYER), IntToFixed(c_gameSpeedSlower));
    DialogControlSetPropertyAsFixed(arenaSpeedSlider, c_triggerControlPropertyMaxValue,
        PlayerGroupSingle(ARENA_PLAYER), IntToFixed(c_gameSpeedFaster));
    DialogControlSetPropertyAsText(arenaSpeedSlider, c_triggerControlPropertyTooltip,
        PlayerGroupSingle(ARENA_PLAYER), StringToText("Changes game speed immediately for the whole match."));
    speedHelpLabel = DialogControlCreate(arenaDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(speedHelpLabel, PlayerGroupSingle(ARENA_PLAYER), 260, 24);
    DialogControlSetPosition(speedHelpLabel, PlayerGroupSingle(ARENA_PLAYER), c_anchorTopLeft, 20, 490);
    libNtve_gf_SetDialogItemText(speedHelpLabel, StringToText("Left: Slower   Right: Faster"), PlayerGroupSingle(ARENA_PLAYER));
    GameSetSpeedLocked(false);
    GameSetSpeedValueMinimum(c_gameSpeedSlower);
    ArenaSetSpeed(c_gameSpeedNormal);
    ArenaRefreshStatus();
    DialogSetVisible(arenaDialog, PlayerGroupSingle(ARENA_PLAYER), true);

    buttonTrigger = TriggerCreate("ArenaButtonClicked");
    TriggerAddEventDialogControl(buttonTrigger, ARENA_PLAYER, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    menuTrigger = TriggerCreate("ArenaMenuChanged");
    TriggerAddEventDialogControl(menuTrigger, ARENA_PLAYER, arenaRaceMenu, c_triggerControlEventTypeSelectionChanged);
    TriggerAddEventDialogControl(menuTrigger, ARENA_PLAYER, arenaUnitMenu, c_triggerControlEventTypeSelectionChanged);
    speedTrigger = TriggerCreate("ArenaSpeedChanged");
    TriggerAddEventDialogControl(speedTrigger, ARENA_PLAYER, arenaSpeedSlider, c_triggerControlEventTypeValueChanged);
    speedSyncTrigger = TriggerCreate("ArenaSpeedSync");
    TriggerAddEventTimePeriodic(speedSyncTrigger, 0.5, c_timeReal);
    deathTrigger = TriggerCreate("ArenaUnitDied");
    TriggerAddEventUnitDied(deathTrigger, null);
}


bool ArenaMapInit (bool testConds, bool runActions) {
    if (runActions) {
        ArenaInit();
    }
    return true;
}

void InitMap () {
    trigger init;
    libNtve_InitLib();
    init = TriggerCreate("ArenaMapInit");
    TriggerAddEventMapInit(init);
}
